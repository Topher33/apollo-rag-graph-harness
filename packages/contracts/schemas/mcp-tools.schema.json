{
  "seed": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query"
      ],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 10
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodes"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string"
              },
              "score": {
                "type": "number"
              }
            }
          }
        }
      }
    }
  },
  "expand": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeIds"
      ],
      "properties": {
        "nodeIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 25,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "hops": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2,
          "default": 1
        },
        "maxBranching": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 10
        },
        "minTier": {
          "enum": [
            "OWNER",
            "SCHEMA",
            "USAGE",
            "LM"
          ]
        },
        "minConfidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodes",
        "edges",
        "truncated"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string"
              },
              "score": {
                "type": "number"
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "urn:harness:schema:edge"
          }
        },
        "truncated": {
          "type": "boolean"
        }
      }
    }
  },
  "drilldown": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeIds"
      ],
      "properties": {
        "nodeIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 25,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mode": {
          "enum": [
            "cached",
            "live"
          ],
          "default": "cached"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "source",
              "content",
              "stale"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "enum": [
                  "index",
                  "live"
                ]
              },
              "content": {
                "type": "object"
              },
              "stale": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
