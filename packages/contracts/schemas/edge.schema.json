{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:harness:schema:edge",
  "title": "Edge",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "from",
    "to",
    "type",
    "direction",
    "tier",
    "confidence",
    "provenance"
  ],
  "properties": {
    "from": {
      "type": "string",
      "minLength": 1
    },
    "to": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": [
        "PURCHASED_BY",
        "SHIPPED_TO",
        "BILLED_TO",
        "CONTAINS",
        "REFERENCES",
        "SUPPLIED_BY",
        "STOCKED_AT",
        "CATEGORIZED_AS",
        "OWNED_BY",
        "ASSOCIATED_WITH",
        "OTHER"
      ]
    },
    "proposedTerm": {
      "type": "string",
      "minLength": 1
    },
    "direction": {
      "enum": [
        "FORWARD",
        "BACKWARD",
        "BIDIRECTIONAL"
      ]
    },
    "tier": {
      "enum": [
        "OWNER",
        "SCHEMA",
        "USAGE",
        "LM"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "snippet"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "snippet": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ts"
      ],
      "properties": {
        "ts": {
          "type": "string",
          "format": "date-time"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "promptVersion": {
          "type": "string",
          "minLength": 1
        },
        "glossaryVersion": {
          "type": "string",
          "minLength": 1
        },
        "schemaVersion": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "tier": {
            "const": "LM"
          }
        },
        "required": [
          "tier"
        ]
      },
      "then": {
        "required": [
          "evidence"
        ],
        "properties": {
          "evidence": {
            "minItems": 1
          },
          "provenance": {
            "required": [
              "ts",
              "model",
              "promptVersion"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tier": {
            "enum": [
              "OWNER",
              "SCHEMA"
            ]
          }
        },
        "required": [
          "tier"
        ]
      },
      "then": {
        "properties": {
          "confidence": {
            "const": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "OTHER"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "proposedTerm"
        ]
      }
    }
  ]
}
